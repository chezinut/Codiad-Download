[
    {
        "author": "CheziNut",
        "version": "1.1.0",
        "name": "File Download",
        "url": "https://github.com/chezinut/Codiad-Download",
        "contextmenu": [
            {
                "action": "codiad.Download.file($('#context-menu').attr('data-path'));",
                "icon": "icon-download",
                "applies-to": "file-only",
                "title": "Download"
            },
            {
                "action": "codiad.Download.directory($('#context-menu').attr('data-path'));",
                "icon": "icon-download",
                "applies-to": "directory-only",
                "title": "Download as ZIP"
            }
        ]
    }
]
